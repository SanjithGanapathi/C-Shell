+int
+kwait_stat(int *wtime, int *rtime, int *status) // Note: stime is no longer needed
+{
+  struct proc *pp;
+  int havekids, pid;
+  struct proc *p = myproc();
+
+  acquire(&wait_lock);
+
+  for(;;){
+    havekids = 0;
+    for(pp = proc; pp < &proc[NPROC]; pp++){
+      if(pp->parent == p){
+        acquire(&pp->lock);
+        havekids = 1;
+        if(pp->state == ZOMBIE){
+          pid = pp->pid;
+          
+          // --- Perform Final Calculations Here ---
+          int termination_time = ticks;
+          int turnaround_time = termination_time - pp->creation_time;
+          int waiting_time = turnaround_time - pp->running_time;
+          
+          // Copy out the calculated stats to user space pointers
+          if(copyout(p->pagetable, (uint64)wtime, (char *)&waiting_time, sizeof(int)) < 0 ||
+             copyout(p->pagetable, (uint64)rtime, (char *)&pp->running_time, sizeof(int)) < 0 ||
+             copyout(p->pagetable, (uint64)status, (char *)&pp->xstate, sizeof(int)) < 0) {
+            
+            release(&pp->lock);
+            release(&wait_lock);
+            return -1;
+          }
+          freeproc(pp);
+          release(&pp->lock);
+          release(&wait_lock);
+          return pid;
+        }
+        release(&pp->lock);
+      }
