+#ifdef SCHEDULER_CFS
+#define TARGET_LATENCY 48
+#define MIN_TIMESLICE 3
+
+void
+scheduler(void)
+{
+  struct proc *p;
+  struct cpu *c = mycpu();
+  c->proc = 0;
+
+  for(;;){
+    // This pattern is crucial for a stable idle loop.
+    intr_on();
+    intr_off();
+
+    struct proc *chosen = 0;
+    int nrunnable = 0;
+
+    // Perform a single, atomic pass to find all runnable processes,
+    // log them, and select the best one.
+    // This loop ends holding the lock on the 'chosen' process.
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        nrunnable++; // Count the candidate
+
+        // Compare it to the best candidate found so far.
+        if(chosen == 0 || p->vruntime < chosen->vruntime) {
+          // If we had a previous best, release its lock.
+          if(chosen)
+            release(&chosen->lock);
+          // This is the new best. Keep its lock.
+          chosen = p;
+        } else {
+          // Not the best, release its lock.
+          release(&p->lock);
+        }
+      } else {
+        // Not runnable, release its lock.
+        release(&p->lock);
+      }
+    }
+
+    if(chosen){
+      // If we found a process, we already hold its lock.
+      // Now, log all runnable processes for this tick.
+      printf("\n[Scheduler Tick]\n");
+      for (p = proc; p < &proc[NPROC]; p++) {
+          if (p->state == RUNNABLE) {
+              printf("PID: %d | vRuntime: %lld\n", p->pid, p->vruntime / VRUNTIME_SCALE);
+          }
+      }
+
+      int time_slice = TARGET_LATENCY / nrunnable;
+      if (time_slice < MIN_TIMESLICE) time_slice = MIN_TIMESLICE;
+      printf("--> Scheduling PID %d (lowest vRuntime)\n", chosen->pid);
+
+      chosen->timeslice = time_slice;
+      chosen->ticks_run = 0;
+      chosen->state = RUNNING;
+      c->proc = chosen;
+
+      swtch(&c->context, &chosen->context);
+
+      // Process is done running for now.
+      c->proc = 0;
+
+      // After the switch, the process we switched from might not be 'chosen'
+      // anymore if another CPU is also scheduling. The lock is released
+      // by the process when it calls sched() or yield(). Here we just
+      // need to release the lock on the process that was chosen *in this pass*.
+      release(&chosen->lock);
+
+    } else {
+      // Nothing was chosen, so wait for an interrupt.
+      asm volatile("wfi");
+    }
+  }
+}
+#endif
 
