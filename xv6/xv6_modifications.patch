+// approximates weight = 1024 / (1.25 ^ nice) using integer ops
+// nice in [-20, +19]
+#ifdef SCHEDULER_CFS
+static long
+calc_weight(int nice)
+{
+  long long w = 1024LL;
+  int i;
+  if (nice >= 0) {
+    for (i = 0; i < nice; i++) {
+      // multiply by 4/5 => w = w * 4 / 5 (round)
+      w = (w * 4 + 2) / 5;
+      if (w < 1) w = 1;
+    }
+  } else {
+    for (i = 0; i < -nice; i++) {
+      // multiply by 5/4 => w = w * 5 / 4 (round)
+      w = (w * 5 + 2) / 4;
+    }
+  }
+  if (w < 1) w = 1;
+  return (long) w;
+}
+#endif
